{
  "expo": {
    "name": "RadioLog",
    "slug": "radiolog",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "br.radiolog.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "O RadioLog grava o áudio do rádio para transcrição."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "br.radiolog.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": "O RadioLog grava o áudio do rádio para transcrição.",
          "enableBackgroundRecording": true
        }
      ],
      "expo-sqlite"
    ]
  }
}
# Serviço de transcrição compatível com a API da OpenAI.
# Groq (rápido e barato): https://api.groq.com/openai/v1  modelo whisper-large-v3
# OpenAI:                 https://api.openai.com/v1       modelo gpt-4o-transcribe
TRANSCRIBE_API_URL=https://api.groq.com/openai/v1
TRANSCRIBE_API_KEY=
TRANSCRIBE_MODEL=whisper-large-v3

# Senha que o app envia para usar o servidor (configure a mesma no app).
APP_TOKEN=troque-esta-senha
PORT=3000
